#!/usr/bin/env php
<?php
if (PHP_SAPI !== 'cli') {
    echo "This script must be run from the command line.\n";
    exit(2);
}

$projectRoot = dirname(__DIR__);
$autoload = $projectRoot . '/vendor/autoload.php';
if (!is_file($autoload)) {
    echo "Autoloader not found. Run composer install first.\n";
    exit(2);
}
require $autoload;

$app = new \Symfony\Component\Console\Application('Architecture Discovery', '1.0.0');
$app->add(new \ArchitectureDiscovery\Application\Command\AnalyseCommand());
$app->run();
